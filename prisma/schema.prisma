// Try Prisma Accelerate: https://pris.ly/cli/accelerate-init

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model PriceHistory {
  id        Int      @id @default(autoincrement())
  stockId   String
  price     Float
  timestamp DateTime @default(now())

  @@index([stockId, timestamp])
}
